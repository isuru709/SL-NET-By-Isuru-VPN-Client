                                <TextBox Name="SecurityTextBox" Style="{StaticResource ModernTextBox}" 
                                         IsReadOnly="True" 
                                         IsTabStop="False"
                                         Foreground="{StaticResource TextSecondaryBrush}" 
                                         Background="#0F1323" 
                                         Margin="0,0,0,16"/>

                                <!-- Transport -->
                                <TextBlock Text="Transport Type" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBox Name="TransportTextBox" Style="{StaticResource ModernTextBox}" 
                                         IsReadOnly="True" 
                                         IsTabStop="False"
                                         Foreground="{StaticResource TextSecondaryBrush}" 
                                         Background="#0F1323" 
                                         Margin="0,0,0,16"/>

