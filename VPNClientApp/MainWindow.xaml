            </TabItem>
            
            <!-- Share VPN Tab MUST be last: moved here after all other tabs -->
            <TabItem Header="🔗 Share VPN" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Share Configuration & URL Filtering -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🔗 Share Your VPN" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="Expose your local VPN proxies to your LAN by binding to a host and ports below." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                                <Separator Margin="0,0,0,16" Background="{StaticResource BorderBrush}"/>

                                <TextBlock Text="Listen Address" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <ComboBox Name="ShareListenHostComboBox" Height="40" Margin="0,0,0,16">
                                    <ComboBoxItem Content="127.0.0.1 (Local only)" Tag="127.0.0.1"/>
                                    <ComboBoxItem Content="0.0.0.0 (All interfaces - LAN)" IsSelected="True" Tag="0.0.0.0"/>
                                </ComboBox>
                                <TextBlock Text="If you select 127.0.0.1 remote devices (phone) cannot reach the share. Use 0.0.0.0 then connect via your LAN IP." FontSize="11" Foreground="#DC3545" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                <TextBlock Text="Public HTTP Port" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBox Name="ShareHttpPortTextBox" Style="{StaticResource ModernTextBox}" Text="8888"/>

                                <TextBlock Text="Public SOCKS5 Port" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="12,12,0,6"/>
                                <TextBox Name="ShareSocksPortTextBox" Style="{StaticResource ModernTextBox}" Text="1080"/>

                                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                    <CheckBox Name="ShareHttpCheck" Content="Share HTTP" IsChecked="True" Margin="0,0,15,0"/>
                                    <CheckBox Name="ShareSocksCheck" Content="Share SOCKS5"/>
                                </StackPanel>

                                <Separator Margin="0,18,0,18" Background="{StaticResource BorderBrush}"/>

                                <!-- Global Speed Limit Section -->
                                <TextBlock Text="⚡ Global Speed Limit" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="System-wide speed limit (applies to host PC and all shared clients). Requires administrator privileges." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Download Limit (KB/s):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBox Name="GlobalDownloadLimitTextBox" Style="{StaticResource ModernTextBox}" Text="0"/>
                                        <TextBlock Text="0 = unlimited" FontSize="10" Foreground="#999" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Upload Limit (KB/s):" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBox Name="GlobalUploadLimitTextBox" Style="{StaticResource ModernTextBox}" Text="0"/>
                                        <TextBlock Text="0 = unlimited" FontSize="10" Foreground="#999" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <Button Name="ApplyGlobalSpeedLimitButton" 
                                        Content="✅ Apply Global Speed Limit" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="{StaticResource InfoBrush}" 
                                        Padding="28,11" 
                                        MinWidth="160"
                                        Margin="0,0,0,8"
                                        Click="ApplyGlobalSpeedLimitButton_Click"/>

                                <Button Name="RemoveGlobalSpeedLimitButton" 
                                        Content="❌ Remove Limit" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="{StaticResource DangerBrush}" 
                                        Padding="28,11" 
                                        MinWidth="160"
                                        Margin="0,0,0,12"
                                        Click="RemoveGlobalSpeedLimitButton_Click"/>

                                <TextBlock Name="GlobalSpeedLimitStatusText" 
                                           Text="Global Limit: Not Applied" 
                                           FontSize="11" 
                                           Foreground="#8B92A5"
                                           Margin="0,0,0,15"/>

                                <Separator Margin="0,0,0,18" Background="{StaticResource BorderBrush}"/>

                                <!-- URL Filtering Section -->
                                <TextBlock Text="🎯 URL Filtering" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                                <TextBlock Text="Shared VPN clients can ONLY access these URLs. PC has unrestricted access." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Add Allowed URL" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                                <TextBlock Text="Enter domain (e.g., google.com) or full URL. Only these will work through shared VPN." FontSize="11" Foreground="#8B92A5" Margin="0,0,0,5"/>
                                
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="ShareFilterUrlTextBox" 
                                             Grid.Column="0" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Background="#0F1323" 
                                             Foreground="#E8EAED"/>
                                    <Button Name="AddShareFilterButton" 
                                            Grid.Column="2" 
                                            Content="➕ Add" 
                                            Style="{StaticResource ModernButton}" 
                                            Background="{StaticResource SuccessBrush}" 
                                            Padding="22,11" 
                                            MinWidth="100"
                                            Click="AddShareFilterButton_Click"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <CheckBox Name="EnableShareFilterCheck" 
                                              Content="Enable URL Filtering" 
                                              Margin="0,0,15,0"/>
                                    <TextBlock Text="⚠" 
                                               FontSize="16" 
                                               Foreground="#FFC107" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Blocks unlisted URLs" 
                                               FontSize="11" 
                                               Foreground="#8B92A5" 
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button Name="ApplyShareFilterButton" 
                                        Content="✅ Apply Filter" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="{StaticResource InfoBrush}" 
                                        Padding="28,11" 
                                        MinWidth="140"
                                        Margin="0,0,0,12"
                                        Click="ApplyShareFilterButton_Click"/>

                                <TextBlock Name="ShareFilterStatusText" 
                                           Text="Filter: Disabled" 
                                           FontSize="11" 
                                           Foreground="#8B92A5"
                                           Margin="0,0,0,15"/>

                                <Separator Margin="0,0,0,15"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,0">
                                    <Button Name="StartShareButton" Content="▶ Start Share" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" Padding="32,11" MinWidth="140" Click="StartShareButton_Click" Margin="0,0,16,0" IsEnabled="False"/>
                                    <Button Name="StopShareButton" Content="⏹ Stop Share" Style="{StaticResource ModernButton}" Background="{StaticResource DangerBrush}" Padding="32,11" MinWidth="140" Click="StopShareButton_Click" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Share Status & Filter List -->
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="📊 Share Status" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,18"/>

                                <Border Name="ShareStatusBadge" 
                                        Style="{StaticResource StatusBadge}" 
                                        Background="{StaticResource WarningBrush}" 
                                        Margin="0,0,0,24">
                                    <TextBlock Name="ShareStatusText" 
                                               Text="⚫ Stopped" 
                                               Foreground="White" 
                                               FontWeight="Bold" 
                                               FontSize="14"/>
                                </Border>

                                <TextBlock Text="Endpoints" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Name="ShareHttpInfo" Text="HTTP: -" FontSize="12" Foreground="#8B92A5" Margin="0,0,0,5"/>
                                <TextBlock Name="ShareSocksInfo" Text="SOCKS5: -" FontSize="12" Foreground="#8B92A5"/>
                                <TextBlock Text="Use these addresses in your phone's Wi‑Fi proxy settings (HTTP proxy). Mobile Hotspot alone will NOT route through the VPN; you must set the proxy on the phone." FontSize="11" Foreground="#8B92A5" TextWrapping="Wrap" Margin="10,10,0,0"/>

                                <Separator Margin="0,10,0,10"/>

                                <TextBlock Text="Connections" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                <TextBlock Name="ShareActiveText" Text="Active: 0" FontSize="12" Foreground="#007ACC"/>
                                <TextBlock Name="ShareTotalText" Text="Total: 0" FontSize="12" Foreground="#00E676"/>

                                <Separator Margin="0,10,0,10"/>

                                <TextBlock Text="Allowed URLs" FontSize="14" FontWeight="Bold" Foreground="#E8EAED" Margin="0,0,0,10"/>
                                <TextBlock Text="Shared VPN clients can only access:" FontSize="11" Foreground="#8B92A5" Margin="0,0,0,5"/>
                                <ListBox Name="ShareFilteredUrlsListBox" 
                                         Height="200" 
                                         Margin="0,0,0,10"
                                         BorderBrush="#DDDDDD"
                                         BorderThickness="1"
                                         Background="#0F1323"/>
                                <Button Name="DeleteShareFilterButton" 
                                        Content="🗑 Delete Selected" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="#6C757D" 
                                        Padding="18,11" 
                                        MinWidth="160"
                                        Click="DeleteShareFilterButton_Click"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- SNI Check Tab -->
            <TabItem Header="🧪 SNI Check" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Controls + Results -->
                    <Grid Grid.Column="0">
                        <!-- Controls -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel Margin="10">
                                <TextBlock Text="🔎 Test SNI acceptability for TLS tunneling" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Enter SNI:" FontWeight="SemiBold"/>
