                            FontSize="13" 
                            Grid.Row="1" 
                            Grid.Column="2"
                            Height="40"
                            MinWidth="120"
                            VerticalAlignment="Center"/>

                    <Button x:Name="UpdateConfigButton" 
                            Content="🔄 FETCH" 
                            Style="{StaticResource ModernButton}" 
                            Background="{StaticResource SuccessBrush}" 
                            Padding="20,11" 
