                                <Button Name="SpeedStopButton" Content="⏹ Stop" Style="{StaticResource ModernButton}" Background="{StaticResource DangerBrush}" Padding="24,11" MinWidth="100" Margin="12,0,0,0" Click="SpeedStopButton_Click" IsEnabled="False"/>
                            </StackPanel>

                            <TextBlock Text="Notes: If VPN is connected, tests will use the VPN HTTP proxy path automatically." FontSize="11" Foreground="#8B92A5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: Summary -->
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="📊 Speed Summary" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Border Name="SpeedBadgePing" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Ping" FontSize="11"/></Border>
                                    <Border Name="SpeedBadgeDownload" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="DL" FontSize="11"/></Border>
                                    <Border Name="SpeedBadgeUpload" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="UL" FontSize="11"/></Border>
                                    <Border Name="SpeedBadgeGaming" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Gaming" FontSize="11"/></Border>
                                    <Border Name="SpeedBadgeStreaming" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Streaming" FontSize="11"/></Border>
                                    <Border Name="SpeedBadgeBrowsing" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Browsing" FontSize="11"/></Border>
                                </WrapPanel>
                                <TextBlock Text="Latency:" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Name="SpeedPingText" Text="-" FontSize="12" Foreground="#8B92A5" Margin="0,0,0,8"/>
                                <TextBlock Text="Download Throughput:" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Name="SpeedDownloadText" Text="-" FontSize="12" Foreground="#8B92A5" Margin="0,0,0,8"/>
                                <TextBlock Text="Upload Throughput:" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Name="SpeedUploadText" Text="-" FontSize="12" Foreground="#8B92A5" Margin="0,0,0,8"/>
                                <TextBlock Text="Use Case Ratings:" FontSize="13" FontWeight="Bold"/>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Name="SpeedGamingText" Text="-" FontSize="12" Foreground="#8B92A5"/>
                                    <TextBlock Name="SpeedStreamingText" Text="-" FontSize="12" Foreground="#8B92A5"/>
                                    <TextBlock Name="SpeedBrowsingText" Text="-" FontSize="12" Foreground="#8B92A5"/>
                                </StackPanel>
                                <Border Name="SpeedOverallBorder" Background="#1A1F35" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Overall Quality" FontSize="13" FontWeight="Bold" Foreground="#E8EAED"/>
                                        <TextBlock Name="SpeedOverallText" Text="-" FontSize="12" Foreground="#E8EAED" TextWrapping="Wrap"/>
                                    </StackPanel>
