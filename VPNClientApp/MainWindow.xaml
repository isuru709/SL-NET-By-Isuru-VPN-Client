                    <!-- Right: Summary Panel -->
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="📊 SNI Summary" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>
                                <WrapPanel Margin="0,0,0,10">
                                    <Border Name="SniBadgeConnectivity" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Conn" FontSize="11"/></Border>
                                    <Border Name="SniBadgeTLS" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="TLS" FontSize="11"/></Border>
                                    <Border Name="SniBadgeIdle" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Idle" FontSize="11"/></Border>
                                    <Border Name="SniBadgeRedirect" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Redirect" FontSize="11"/></Border>
                                    <Border Name="SniBadgeSpeed" Background="#2A3050" CornerRadius="4" Padding="6,3" Margin="0,0,6,6"><TextBlock Text="Speed" FontSize="11"/></Border>
                                </WrapPanel>
                                <TextBlock Text="Ping:" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Name="SniPingText" Text="-" FontSize="12" Foreground="#8B92A5" Margin="0,0,0,8"/>
                                <TextBlock Text="TLS Handshake:" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Name="SniTlsText" Text="-" FontSize="12" Foreground="#8B92A5" Margin="0,0,0,8"/>
                                <TextBlock Text="Idle Tolerance:" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Name="SniIdleText" Text="-" FontSize="12" Foreground="#8B92A5" Margin="0,0,0,8"/>
                                <TextBlock Text="Redirect / Throughput:" FontSize="13" FontWeight="Bold"/>
                                <TextBlock Name="SniSpeedText" Text="-" FontSize="12" Foreground="#8B92A5" Margin="0,0,0,8"/>
                                <Border Name="SniOverallBorder" Background="#1A1F35" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Overall Verdict" FontSize="13" FontWeight="Bold" Foreground="#E8EAED"/>
                                        <TextBlock Name="SniClassText" Text="-" FontSize="12" Foreground="#E8EAED" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Speed Test Tab -->
            <TabItem Header="🚀 Speed Test" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Controls -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="10">
                                <TextBlock Text="Network Speed &amp; Latency" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,12"/>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Ping Host:" FontWeight="SemiBold"/>
                                    <TextBox Name="SpeedPingHostTextBox" Style="{StaticResource ModernTextBox}" Text="1.1.1.1"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Test Duration (s):" FontWeight="SemiBold"/>
                                    <TextBox Name="SpeedDurationTextBox" Style="{StaticResource ModernTextBox}" Text="8"/>
                                </StackPanel>
