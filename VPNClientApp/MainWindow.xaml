                                <TextBlock Name="SSHProxyInfo" Text="" FontSize="11" Foreground="#8B92A5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

