                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Port:" FontWeight="SemiBold"/>
                                        <TextBox Name="SniPortTextBox" Style="{StaticResource ModernTextBox}" Text="443" Width="120"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button Name="SniCheckButton" Content="▶ Check" Style="{StaticResource ModernButton}" Background="{StaticResource SuccessBrush}" Padding="24,11" MinWidth="100" Click="SniCheckButton_Click"/>
                                        <Button Name="SniStopButton" Content="⏹ Stop" Style="{StaticResource ModernButton}" Background="{StaticResource DangerBrush}" Padding="24,11" MinWidth="90" Margin="12,0,0,0" Click="SniStopButton_Click" IsEnabled="False"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Name="SniInlineStatusText" Text="" FontSize="12" Foreground="#8B92A5" Margin="0,5,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
