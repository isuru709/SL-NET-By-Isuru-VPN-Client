                                    <TextBlock Text="SNI (Server Name Indication)" 
                                               FontWeight="SemiBold" 
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text=" • Editable" 
                                               Foreground="{StaticResource PrimaryBrush}" 
                                               FontSize="11" 
                                               FontWeight="SemiBold"
                                               Margin="6,2,0,0"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Name="SNITextBox" Grid.Column="0" Style="{StaticResource ModernTextBox}" 
                                             Background="#0F1323" Foreground="#E8EAED" Margin="0,0,10,0"/>
