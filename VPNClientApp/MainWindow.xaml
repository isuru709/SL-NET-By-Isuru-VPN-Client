                                <TextBlock Height="16" Margin="0,0,0,0"/>

                                <TextBlock Text="Or use SSH Key Authentication" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
