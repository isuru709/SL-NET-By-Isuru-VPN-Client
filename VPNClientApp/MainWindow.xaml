            </TabItem>

            <!-- Blocker Tab -->
            <TabItem Header="🛡 Blocker" FontSize="14" FontWeight="SemiBold">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="1.3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Controls -->
                    <Border Grid.Column="0" Style="{StaticResource CardPanel}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10">
                            <TextBlock Text="Domain Blocker (System Proxy)" FontSize="17" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Blocks at local HTTP proxy via routing rules. No PAC used." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="⚠️ Note: YouTube ads cannot be blocked (served from same domains as videos)" FontSize="11" Foreground="#FF6B6B" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <TextBlock Text="Categories" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <StackPanel>
                                <CheckBox x:Name="AdsBlockCheck" Content="Ads Block (Enable lists below for better blocking)" IsChecked="False"/>
                                <CheckBox x:Name="AdultBlockCheck" Content="18+ Block" IsChecked="False"/>
                                <CheckBox x:Name="SocialBlockCheck" Content="Social Media Block" IsChecked="False"/>
                            </StackPanel>

                            <Separator Margin="0,10,0,10"/>

                            <TextBlock Text="Custom URL/Domain" FontWeight="SemiBold"/>
                            <TextBlock Text="Enter domain (e.g., example.com) or full URL; it will normalize to domain." FontSize="11" Foreground="#8B92A5"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomBlockTextBox" Style="{StaticResource ModernTextBox}" Grid.Column="0"/>
                                <Button x:Name="AddBlockButton" Content="➕ Add" Style="{StaticResource ModernButton}" Grid.Column="2" Background="{StaticResource SuccessBrush}" Padding="22,11" MinWidth="100" Click="AddBlockButton_Click"/>
                            </Grid>

                            <Separator Margin="0,12,0,10"/>

                            <TextBlock Text="Whitelist URL/Domain" FontWeight="SemiBold"/>
                            <TextBlock Text="Bypass blocking and route DIRECT (no VPN)" FontSize="11" Foreground="#8B92A5"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WhitelistTextBox" Style="{StaticResource ModernTextBox}" Grid.Column="0"/>
                                <Button x:Name="AddWhitelistButton" Content="➕ Add" Style="{StaticResource ModernButton}" Grid.Column="2" Background="{StaticResource SuccessBrush}" Padding="22,11" MinWidth="100" Click="AddWhitelistButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="BlockerStatusText" Text="Not applied" Foreground="#8B92A5" Margin="0,10,0,0"/>

                            <Separator Margin="0,12,0,12" Background="{StaticResource BorderBrush}"/>
                            <TextBlock Text="Advanced Ads Block Lists" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Click 'Update Lists' first to download, then Apply to use them" FontSize="11" Foreground="#8B92A5" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="UseOisdSmallCheck" Content="OISD Small" Margin="0,0,10,0" IsChecked="False"/>
                                    <CheckBox x:Name="UseOisdMediumCheck" Content="EasyList" Margin="0,0,10,0" IsChecked="False"/>
                                    <CheckBox x:Name="UseOisdFullCheck" Content="Full Hosts" IsChecked="False"/>
