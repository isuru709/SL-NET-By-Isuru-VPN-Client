                                </StackPanel>
                                <TextBox Name="SSHSNITextBox" Style="{StaticResource ModernTextBox}" 
                                         Background="#0F1323" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                                <TextBlock Text="Connection Options" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <CheckBox Name="UseSSHTLSCheck" Content="Enable TLS wrapping (recommended for non-standard SSH ports)" IsChecked="True" Margin="0,0,0,4"/>
                                <TextBlock Text="Tip: Disable TLS if connecting to standard SSH (port 22)" FontSize="11" Foreground="#8B92A5" Margin="20,0,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Right: SSH Status & Stats -->
                    <Border Grid.Column="2" Style="{StaticResource CardPanel}">
