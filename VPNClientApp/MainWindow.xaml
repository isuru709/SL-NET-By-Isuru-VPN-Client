                                <Separator Margin="0,0,0,18" Background="{StaticResource BorderBrush}"/>

                                <TextBlock Text="Advanced Options (for 3x-ui panels)" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
