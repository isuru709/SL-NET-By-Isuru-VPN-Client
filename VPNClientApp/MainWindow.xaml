                                            <TextBlock Text="Share your active VPN connection with other devices on your network with optional URL filtering." FontSize="13" Foreground="#8B92A5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <TextBlock Text="How to use:" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" Margin="0,0,0,4"/>
                                            <TextBlock Text="1. Connect to VPN first (from any tab)" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="2. Listen Address: 127.0.0.1 (local only) or 0.0.0.0 (allow LAN devices)" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="3. Set Public HTTP Port and SOCKS5 Port (e.g., 8080, 1080)" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="4. Choose which proxy type to share (HTTP and/or SOCKS5)" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="5. Optional URL Filtering: Enable and add allowed domains to restrict access" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="6. Click 'Start Share' - Use displayed endpoints on mobile/other devices" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                        </StackPanel>
                                    </Border>

