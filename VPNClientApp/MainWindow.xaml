                                            <TextBlock Text="2. External Lists: Check OISD Small/EasyList/Full Hosts and click 'Update Lists'" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="3. Custom Blocking: Enter domain/URL in Custom Block field and click 'Add'" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="4. Whitelist: Add domains to bypass blocking and route directly (no VPN)" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="5. Click 'Apply' to activate all blocking rules" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="6. Manage: Select items from lists and use 'Delete Selected' to remove" FontSize="12" Foreground="#8B92A5" Margin="5,0,0,2"/>
                                            <TextBlock Text="Note: Blocks at DNS/routing level. Browser extensions may provide additional cosmetic filtering." FontSize="11" Foreground="#8B92A5" FontStyle="Italic" Margin="5,8,0,0"/>
